# Dalal Dojo Server Environment Variables

PORT=5000
NODE_ENV=production

# Strong secret key for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Allowed frontend origin for CORS. In production, set to your Vercel URL:
# Multiple origins can be comma-separated: https://dalaldojo.vercel.app,http://localhost:5173
CLIENT_URL=https://dalaldojo.vercel.app

# Path to the SQLite database file
# Default for local development: ./data/dalaldojo.db
# For Render Web Service with persistent disk mounted at /var/data:
DB_PATH=/var/data/dalaldojo.db
DATABASE_PATH=/var/data/dalaldojo.db

# Cookie SameSite attribute:
# Set to 'none' when frontend and backend are hosted on different domains over HTTPS (e.g. vercel.app and onrender.com)
# Set to 'lax' for local development on localhost
COOKIE_SAME_SITE=none
