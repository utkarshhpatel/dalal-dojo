# Dalal Dojo Monorepo Environment Configuration Reference

# ==============================================================================
# Client / Frontend Environment Variables (Vercel)
# ==============================================================================
# The backend API URL. Leave empty in local development to use Vite's dev proxy.
# In production on Vercel, set this to your hosted backend URL (e.g. Render):
VITE_API_URL=https://your-backend.onrender.com

# ==============================================================================
# Server / Backend Environment Variables (Render)
# ==============================================================================
PORT=5000
NODE_ENV=production

# Random secret string for signing JWT tokens (generate a strong 64-char key)
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Frontend URL(s) allowed by CORS. Supports comma-separated origins.
# Example: https://dalal-dojo.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# SQLite database file path.
# For local development: ./data/dalaldojo.db (default)
# For Render Web Service with persistent disk mounted at /var/data:
DATABASE_PATH=/var/data/dalaldojo.db

# Cookie SameSite policy:
# 'none' for cross-domain HTTPS (Frontend on Vercel <-> Backend on Render)
# 'lax' for local development
COOKIE_SAME_SITE=none
